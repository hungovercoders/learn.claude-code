{
  "permissions": {
    "allow": [
      "Bash(jq:*)",
      "Bash(./pick-film.sh:*)",
      "Bash(bash pick-film.sh:*)",
      "Read(./films.json)",
      "Read(./CLAUDE.md)",
      "Edit(./films.json)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/films-validate.sh" }
        ]
      }
    ]
  }
}
